# Optional: absolute URL of the backend API (default: same origin, e.g. the Vite dev proxy).
# Set this when the frontend is hosted separately from the backend, e.g. Vercel/Netlify.
# VITE_API_URL=https://api.example.com

# Optional: shared app API key. Sent as X-API-Key and must match the backend's APP_API_KEY.
# NOTE: this is embedded in the static bundle, so it gates casual access only — not a strong secret.
# VITE_API_KEY=
