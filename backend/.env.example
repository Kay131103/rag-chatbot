# Choose the LLM provider: gemini (default, free tier) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=1024

# ChromaDB persistence (needs a writable, persistent directory)
CHROMA_PATH=./chroma_data
COLLECTION_NAME=documents

# Optional: require this key in the X-API-Key header for every /api call (except /api/health)
APP_API_KEY=

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
MAX_DISTANCE=1.2

# Upload limit (file uploads only; URL ingestion is capped separately at 5 MB)
MAX_UPLOAD_MB=25

# JSON list of browser origins allowed to call the API (set to your deployed frontend)
CORS_ORIGINS=["http://localhost:5173"]
